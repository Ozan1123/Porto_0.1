---
interface Certificate {
  title: string;
  issuer: string;
  date: string;
  file: string;
  icon: string;
}

const certificates: Certificate[] = [
  {
    title: "Google Cloud Roadshows x Build with AI",
    issuer: "Google Developer Group Bogor",
    date: "2025",
    file: "/certificates/google-cloud-build-with-ai.pdf",
    icon: "google"
  },
  {
    title: "IDCamp x Dicoding Live #1",
    issuer: "Dicoding Indonesia",
    date: "2 Oktober 2025",
    file: "/certificates/dicoding-idcamp.pdf",
    icon: "dicoding"
  },
  {
    title: "Google I/O Extended Bogor",
    issuer: "Google Developer Group",
    date: "2024",
    file: "/certificates/google-io-bogor.pdf",
    icon: "google"
  }
];
---

<section id="certificates" class="certificates">
  <div class="cert-container">
    <div class="section-label reveal-bottom">
      <span>achievements</span>
      <span class="label-line"></span>
    </div>

    <h2 class="section-title reveal-bottom">Certifications & Events</h2>
    <p class="section-subtitle reveal-bottom reveal-delay-1">Proof that I actually attend things and learn.</p>

    <div class="cert-grid">
      {
        certificates.map((cert, index) => (
          <a
            href={cert.file}
            target="_blank"
            rel="noopener noreferrer"
            class="cert-card reveal-bottom"
            style={`transition-delay: ${(index + 1) * 0.15}s`}
          >
            <div class="cert-icon-wrap">
              {cert.icon === 'google' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              )}
            </div>
            
            <div class="cert-info">
              <h3 class="cert-title">{cert.title}</h3>
              <p class="cert-issuer mono">{cert.issuer}</p>
              <div class="cert-footer">
                <span class="cert-date">{cert.date}</span>
                <span class="view-text">
                  View PDF
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .certificates {
    padding: var(--space-24) 0;
    position: relative;
  }

  .cert-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-12);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .cert-card {
    display: flex;
    gap: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .cert-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .cert-icon-wrap {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    background: var(--bg-alt);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
  }

  .cert-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .cert-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .cert-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cert-date {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .view-text {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 4px;
    opacity: 0.8;
    transition: all var(--transition-fast);
  }

  .cert-card:hover .view-text {
    opacity: 1;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
