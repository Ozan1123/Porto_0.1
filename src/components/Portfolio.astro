---
interface Project {
  year: string;
  title: string;
  category: string;
  description: string;
  tech: string[];
  image?: string;
  link?: string;
}

const projects: Project[] = [
  {
    year: "2025",
    title: "Guest Attendance App",
    category: "Web Development",
    description:
      "Digital guest registration system with face recognition and real-time monitoring dashboard. Handles concurrent check-ins and generates attendance analytics.",
    tech: ["Laravel", "MySQL", "JavaScript"],
    image: "/projects/absensi.png",
    link: "https://github.com/Ozan1123/tesxa.git",
  },
  {
    year: "2024",
    title: "Simple TodoList",
    category: "Web Development",
    description:
      "Task management app with real-time CRUD operations, drag-and-drop ordering, and persistent storage.",
    tech: ["JavaScript", "CSS", "Vercel"],
    image: "/projects/todolist.png",
    link: "http://todolist-pink-nine.vercel.app/",
  },
  {
    year: "2026",
    title: "Portfolio Website",
    category: "Web Development",
    description:
      "This portfolio — built with Astro, custom CSS, and deliberate animation choices. No template, no framework bloat.",
    tech: ["Astro", "CSS", "JavaScript"],
    image: "/projects/portfolio.png",
    link: "https://porto-0-1.vercel.app/",
  },
];
---

<section id="work" class="portfolio">
  <div class="portfolio-container">
    <div class="section-label reveal-bottom">
      <span>selected_work</span>
      <span class="label-line"></span>
    </div>

    <h2 class="section-title reveal-bottom">Projects I've shipped</h2>
    <p class="section-subtitle reveal-bottom reveal-delay-1">Not just mockups — these are live, deployed, and (mostly) working.</p>

    <div class="projects-grid">
      {
        projects.map((project, index) => (
          <div
            class="project-card reveal-bottom"
            style={`transition-delay: ${(index + 1) * 0.15}s`}
          >
            <div class="project-thumbnail">
              {project.image ? (
                <img
                  src={project.image}
                  alt={project.title}
                  class="thumbnail-image"
                  loading="lazy"
                />
              ) : (
                <div class="thumbnail-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                </div>
              )}
              <div class="thumbnail-overlay">
                <span class="project-year mono">{project.year}</span>
              </div>
            </div>

            <div class="project-info">
              <span class="project-category mono">{project.category}</span>
              <h3 class="project-title">{project.title}</h3>
              <p class="project-description">{project.description}</p>

              <div class="project-tech">
                {project.tech.map((t) => (
                  <span class="tech-tag mono">{t}</span>
                ))}
              </div>

              <a href={project.link} class="project-link" target="_blank" rel="noopener noreferrer">
                <span>View Project</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .portfolio {
    padding: var(--space-24) 0;
    position: relative;
  }

  .portfolio-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-12);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-8);
  }

  .project-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
  }

  .project-thumbnail {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: var(--bg-alt);
  }

  .thumbnail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card:hover .thumbnail-image {
    transform: scale(1.05);
  }

  .thumbnail-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-faint);
  }

  .thumbnail-overlay {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .project-year {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--surface);
    background: var(--primary);
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
  }

  .project-info {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .project-category {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--accent-rose);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin: 0;
  }

  .project-description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .tech-tag {
    font-size: var(--text-xs);
    padding: 2px var(--space-3);
    background: var(--bg-alt);
    color: var(--primary);
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--primary);
    margin-top: var(--space-3);
    transition: all var(--transition-fast);
  }

  .project-link:hover {
    gap: var(--space-3);
    color: var(--primary-dark);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      font-size: var(--text-2xl);
    }
  }
</style>
