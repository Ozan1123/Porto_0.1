---
interface Props {
  description?: string;
}

const {
  description = "I'm an IT student at Devacto IT exploring both Web and Game Development. I like solving problems through code — whether it's crafting a clean REST API, optimizing a database query, or building a game that's actually fun to play. I learn best by breaking things, then figuring out why they broke.",
} = Astro.props;
---

<section id="about" class="about">
  <div class="about-container">
    <div class="section-label reveal-bottom">
      <span>about_me</span>
      <span class="label-line"></span>
    </div>

    <div class="about-content">
      <div class="about-text reveal-left">
        <h2 class="about-heading">
          A developer who likes to <span class="highlight">understand</span> how things work,
          not just use them.
        </h2>

        <p class="description">{description}</p>

        <div class="info-grid">
          <div class="info-card">
            <span class="info-key mono">born</span>
            <span class="info-value">29 Feb 2008</span>
          </div>
          <div class="info-card">
            <span class="info-key mono">location</span>
            <span class="info-value">Cilodong, Depok</span>
          </div>
          <div class="info-card">
            <span class="info-key mono">school</span>
            <span class="info-value">SMK Plus Pelita Nusantara</span>
          </div>
          <div class="info-card">
            <span class="info-key mono">program</span>
            <span class="info-value">Devacto IT</span>
          </div>
        </div>
      </div>

      <div class="about-focus reveal-right">
        <div class="focus-card">
          <div class="focus-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <h3>Backend Systems</h3>
          <p>Building APIs and server logic that can handle real traffic — not just localhost demos.</p>
        </div>

        <div class="focus-card">
          <div class="focus-icon icon-sky">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </div>
          <h3>Database Design</h3>
          <p>Schema architecture and query optimization — making data work the way it should.</p>
        </div>

        <div class="focus-card">
          <div class="focus-icon icon-green">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon>
              <line x1="12" y1="22" x2="12" y2="15.5"></line>
              <polyline points="22 8.5 12 15.5 2 8.5"></polyline>
            </svg>
          </div>
          <h3>Game Development</h3>
          <p>Creating interactive experiences — from simple prototypes to polished gameplay loops.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--space-24) 0;
    position: relative;
  }

  .about-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .about-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .about-heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: var(--space-6);
  }

  .highlight {
    color: var(--primary);
    position: relative;
  }

  .highlight::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    height: 6px;
    background: var(--accent-sky-light);
    border-radius: var(--radius-sm);
    z-index: -1;
  }

  .description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    transition: all var(--transition-fast);
  }

  .info-card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
  }

  .info-key {
    font-size: var(--text-xs);
    color: var(--accent-rose);
    text-transform: lowercase;
  }

  .info-value {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  /* Focus cards */
  .about-focus {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .focus-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--transition-base);
  }

  .focus-card:hover {
    transform: translateX(8px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
  }

  .focus-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--primary-glow);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    transition: all var(--transition-base);
  }

  .focus-icon.icon-sky {
    background: var(--accent-sky-light);
    color: #0EA5E9;
  }

  .focus-icon.icon-green {
    background: var(--accent-green-light);
    color: var(--accent-green);
  }

  .focus-card:hover .focus-icon {
    transform: scale(1.1);
  }

  .focus-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .focus-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .about-heading {
      font-size: var(--text-2xl);
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
