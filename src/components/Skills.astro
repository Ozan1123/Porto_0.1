---
interface Skill {
  name: string;
  level: number; // 1-5
  color: string;
}

const skills: Skill[] = [
  { name: "PHP", level: 4, color: "var(--primary)" },
  { name: "Laravel", level: 5, color: "var(--accent-rose)" },
  { name: "Node.js", level: 3, color: "var(--accent-green)" },
  { name: "Python", level: 2, color: "var(--accent-sky)" },
  { name: "MySQL", level: 5, color: "var(--accent-rose)" },
  { name: "JavaScript", level: 4, color: "var(--primary)" },
  { name: "React", level: 3, color: "var(--accent-sky)" },
];

const tools = ["Git", "Docker", "Postman", "Laragon", "Xampp"];
---

<section id="skills" class="skills">
  <div class="skills-container">
    <div class="section-label reveal-bottom">
      <span>skills_and_tools</span>
      <span class="label-line"></span>
    </div>

    <h2 class="section-title reveal-bottom">What I work with</h2>
    <p class="section-subtitle reveal-bottom reveal-delay-1">Honest skill levels, no inflated numbers.</p>

    <div class="skills-grid reveal-bottom reveal-delay-2">
      {skills.map((skill, index) => (
        <div class="skill-card" style={`transition-delay: ${index * 0.08}s; --skill-color: ${skill.color}`}>
          <div class="skill-header">
            <span class="skill-name mono">{skill.name}</span>
            <span class="skill-level mono">{skill.level}/5</span>
          </div>
          <div class="skill-bar">
            <div class="skill-fill" style={`width: ${skill.level * 20}%; background: ${skill.color}`}></div>
          </div>
        </div>
      ))}
    </div>

    <div class="tools-section reveal-bottom reveal-delay-3">
      <h3 class="tools-title mono">// other tools I use</h3>
      <div class="tools-list">
        {tools.map(tool => (
          <span class="tool-tag">{tool}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    padding: var(--space-24) 0;
    position: relative;
  }

  .skills-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-bottom: var(--space-10);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: all var(--transition-base);
  }

  .skill-card:hover {
    border-color: var(--skill-color);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .skill-name {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
  }

  .skill-level {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .skill-bar {
    width: 100%;
    height: 6px;
    background: var(--bg-alt);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tools-section {
    text-align: center;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .tools-title {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .tools-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .tool-tag {
    padding: var(--space-2) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
    cursor: default;
  }

  .tool-tag:hover {
    background: var(--primary);
    color: var(--surface);
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-primary);
  }

  @media (max-width: 600px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      font-size: var(--text-2xl);
    }
  }
</style>
