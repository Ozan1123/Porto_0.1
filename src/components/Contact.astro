---
interface ContactLink {
  name: string;
  url: string;
  icon: string;
}

const email = "muhammadfauzanpratama420@gmail.com";

const socialLinks: ContactLink[] = [
  { name: "GitHub", url: "https://github.com/Ozan1123", icon: "github" },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/muhammad-fauzan-pratama-776468365",
    icon: "linkedin",
  },
  {
    name: "Instagram",
    url: "https://www.instagram.com/zan_2_you",
    icon: "instagram",
  },
];
---

<section id="contact" class="contact">
  <div class="contact-container">
    <div class="section-label reveal-bottom">
      <span>get_in_touch</span>
      <span class="label-line"></span>
    </div>

    <h2 class="contact-title reveal-bottom">Let's build something.</h2>
    <p class="contact-subtitle reveal-bottom reveal-delay-1">
      Got a project idea, a freelance gig, or just want to talk code?
      Hit me up — I respond faster than most API endpoints.
    </p>

    <div class="contact-email reveal-bottom reveal-delay-2">
      <a href={`mailto:${email}`} class="email-link">
        <span class="email-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <span class="email-text mono">{email}</span>
        <span class="email-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </span>
      </a>
    </div>

    <div class="social-links reveal-bottom reveal-delay-3">
      {
        socialLinks.map((link) => (
          <a
            href={link.url}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.name}
          >
            {link.icon === "github" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            )}
            {link.icon === "linkedin" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect width="4" height="12" x="2" y="9" />
                <circle cx="4" cy="4" r="2" />
              </svg>
            )}
            {link.icon === "instagram" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
              </svg>
            )}
            <span class="social-name">{link.name}</span>
          </a>
        ))
      }
    </div>

    <div class="contact-cta reveal-bottom reveal-delay-4">
      <a href={`mailto:${email}`} class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13"></path>
          <path d="M22 2L15 22 11 13 2 9 22 2z"></path>
        </svg>
        Send a Message
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: var(--space-24) 0 var(--space-16);
    position: relative;
  }

  .contact-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 var(--space-6);
    text-align: center;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .contact-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 auto var(--space-10);
    line-height: 1.7;
  }

  .contact-email {
    margin-bottom: var(--space-8);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
  }

  .email-link:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .email-icon {
    color: var(--primary);
  }

  .email-text {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--text-primary);
  }

  .email-arrow {
    color: var(--text-faint);
    transition: all var(--transition-fast);
  }

  .email-link:hover .email-arrow {
    color: var(--primary);
    transform: translate(3px, -3px);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    transition: all var(--transition-base);
  }

  .social-link:hover {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--surface);
    transform: translateY(-4px);
    box-shadow: var(--shadow-primary);
  }

  .social-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .contact-cta {
    margin-top: var(--space-4);
  }

  @media (max-width: 600px) {
    .contact-title {
      font-size: var(--text-3xl);
    }

    .email-link {
      flex-direction: column;
      padding: var(--space-4);
      border-radius: var(--radius-xl);
    }

    .email-arrow {
      display: none;
    }

    .social-links {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
