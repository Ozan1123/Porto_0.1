---
interface Experience {
  period: string;
  role: string;
  company: string;
  description: string;
}

const experiences: Experience[] = [
  {
    period: "Present",
    role: "Web & Game Developer",
    company: "Devacto IT — SMK Plus Pelita Nusantara",
    description: "Learning and building real projects in both Web Development and Game Development tracks. Currently focused on Laravel backend systems and Unity game prototyping.",
  }
];
---

{experiences.length > 0 && (
<section id="experience" class="experience">
  <div class="experience-container">
    <div class="section-label reveal-bottom">
      <span>experience</span>
      <span class="label-line"></span>
    </div>

    <h2 class="section-title reveal-bottom">Where I've been</h2>

    <div class="timeline">
      {
        experiences.map((exp, index) => (
          <div
            class="exp-card reveal-left"
            style={`transition-delay: ${index * 0.15}s`}
          >
            <div class="exp-period">
              <span class="period-badge mono">{exp.period}</span>
            </div>
            <div class="exp-content">
              <h3 class="exp-role">{exp.role}</h3>
              <div class="exp-company mono">{exp.company}</div>
              <p class="exp-description">{exp.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
)}

<style>
  .experience {
    padding: var(--space-24) 0;
    position: relative;
  }

  .experience-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-10);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .exp-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-6);
    background: var(--surface);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    transition: all var(--transition-base);
  }

  .exp-card:hover {
    transform: translateX(8px);
    box-shadow: var(--shadow-md);
    border-left-color: var(--accent-rose);
  }

  .period-badge {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--primary);
    padding-top: 4px;
  }

  .exp-role {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .exp-company {
    font-size: var(--text-sm);
    color: var(--accent-rose);
    margin-bottom: var(--space-3);
  }

  .exp-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .exp-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5) var(--space-6);
    }

    .section-title {
      font-size: var(--text-2xl);
    }
  }
</style>
